{
  "system": {
    "prefer_gpu": true,
    "gpu_codec": "auto",
    "fallback_codec": "libx264",
    "threads": 4,
    "log_level": "INFO",
    "hf_token_path": "global/hf_token.json"
  },
  "downloader": {
    "language": "en",
    "image_quality": "data",
    "max_retries": 3,
    "retry_delay_seconds": 2,
    "request_delay_seconds": 0.35
  },
  "pdf": {
    "max_mb": 50.0
  },
  "tts": {
    "voice": "global/voice/animextv.wav",
    "synth_timeout_seconds": 180,
    "hf_repo_id": "ResembleAI/chatterbox-turbo",
    "model_dir": "checkpoints/chatterbox_turbo"
  },
  "audio": {
    "sample_rate": 44100,
    "pause_between_pages_ms": 350,
    "bgm_enabled": false,
    "bgm_path": "",
    "bgm_below_voice_lu": 14.0,
    "enable_loudnorm": true,
    "loudness_target_lufs": -14.0
  },
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "background_style": "blur",
    "blur_brightness": 0.42,
    "background_color": "#000000",
    "page_padding_percent": 4,
    "auto_adaptive_padding": true,
    "page_border_width": 2,
    "page_border_color": "#222222"
  }
}
