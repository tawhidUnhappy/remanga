{
  "system": {
    "prefer_gpu": true,
    "gpu_codec": "h264_nvenc",
    "fallback_codec": "libx264",
    "threads": 4,
    "log_level": "INFO"
  },
  "downloader": {
    "language": "en",
    "image_quality": "data",
    "max_retries": 3,
    "retry_delay_seconds": 2,
    "request_delay_seconds": 0.35,
    "zip_pages_enabled": false
  },
  "cropper": {
    "margin_padding_pixels": 8,
    "auto_contrast_clean": false,
    "save_format": "PNG",
    "panels_per_sheet": 4,
    "panels_per_folder": 10,
    "package": {
      "sheets": true,
      "sheets_zip": false,
      "sheets_folders": false,
      "pdf": false,
      "pdf_splite": false,
      "pdf_zip": false,
      "pdf_zip_splite": false,
      "panels_zip": false,
      "panels_zip_splites": false,
      "max_mb": 50.0
    },
    "snap_to_gutters": true,
    "gutter_search_radius_pixels": 60,
    "gutter_search_radius_fraction": 0.1,
    "gutter_bg_tolerance": 20.0,
    "gutter_min_run_pixels": 3,
    "gutter_min_background_fraction": 0.96,
    "gutter_background_sample_strip_pixels": 12,
    "reconcile_panel_seams": true,
    "seam_max_gap_fraction": 0.15,
    "seam_min_axis_overlap_fraction": 0.5,
    "trim_panel_whitespace": true,
    "trim_min_background_fraction": 0.985,
    "trim_max_margin_fraction": 0.04,
    "dedupe_duplicate_panels": true,
    "duplicate_iou_threshold": 0.6
  },
  "marker": {
    "host": "127.0.0.1",
    "port": 8765,
    "auto_open_browser": true,
    "magi_enabled": true,
    "magi_repo_id": "ragavsachdeva/magiv3",
    "magi_model_dir": "checkpoints/magiv3",
    "magi_panel_score_threshold": 0.5,
    "click_to_select": true,
    "shortcuts": {
      "save": ["mod+s"],
      "mark_full_page": ["mod+f"],
      "tool_draw": ["d"],
      "tool_adjust": ["v"],
      "prev_page": ["arrowleft"],
      "next_page": ["arrowright"],
      "delete_mark": ["delete", "backspace"],
      "reset_view": ["0"]
    }
  },
  "reviewer": {
    "host": "127.0.0.1",
    "port": 8766,
    "auto_open_browser": true
  },
  "tts": {
    "engine": "indextts-2.5",
    "hf_repo_id": "IndexTeam/IndexTTS-2.5",
    "model_dir": "checkpoints/indextts_2.5",
    "cfg_path": "checkpoints/indextts_2.5/config.yaml",
    "spk_audio_prompt": "",
    "lang": "EN",
    "use_bf16": true,
    "speed": 1.0,
    "temperature": 0.8,
    "top_p": 0.8,
    "sample_rate": 22050,
    "synth_timeout_seconds": 180,
    "audio8": {
      "hf_repo_id": "Audio8/Audio8-TTS-Preview-0.1b",
      "model_dir": "checkpoints/audio8_tts_0.1b",
      "reference_text_path": "global/tts_reference.txt",
      "use_bf16": true,
      "temperature": 0.7,
      "top_p": 0.9,
      "max_new_tokens": 512,
      "sample_rate": 44100
    }
  },
  "ocr": {
    "hf_repo_id": "deepseek-ai/DeepSeek-OCR-2",
    "model_dir": "checkpoints/deepseek_ocr_2"
  },
  "audio": {
    "sample_rate": 44100,
    "edge_fade_ms": 35,
    "pause_between_panels_ms": 0,
    "bgm_enabled": false,
    "bgm_path": "",
    "bgm_volume_db": -22.0,
    "enable_loudnorm": true
  },
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background_style": "blur",
    "blur_brightness": 0.42,
    "background_color": "#000000",
    "panel_padding_percent": 4,
    "auto_adaptive_padding": true,
    "panel_border_width": 2,
    "panel_border_color": "#222222"
  }
}
