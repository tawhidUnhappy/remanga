{
  "system": {
    "prefer_gpu": true,
    "gpu_codec": "auto",
    "fallback_codec": "libx264",
    "threads": 4,
    "log_level": "INFO",
    "hf_token_path": "global/hf_token.json"
  },
  "downloader": {
    "language": "en",
    "image_quality": "data",
    "max_retries": 3,
    "retry_delay_seconds": 2,
    "request_delay_seconds": 0.35,
    "zip_pages_enabled": false
  },
  "cropper": {
    "margin_padding_pixels": 8,
    "auto_contrast_clean": false,
    "save_format": "PNG",
    "panels_per_sheet": 4,
    "panels_per_folder": 10,
    "package": {
      "sheets": true,
      "sheets_zip": false,
      "sheets_folders": false,
      "pdf": false,
      "pdf_splite": false,
      "pdf_zip": false,
      "pdf_zip_splite": false,
      "panels_zip": false,
      "panels_zip_splites": false,
      "max_mb": 50.0
    },
    "snap_to_gutters": true,
    "gutter_search_radius_pixels": 60,
    "gutter_search_radius_fraction": 0.1,
    "gutter_bg_tolerance": 20.0,
    "gutter_min_run_pixels": 3,
    "gutter_min_background_fraction": 0.96,
    "gutter_background_sample_strip_pixels": 12,
    "reconcile_panel_seams": true,
    "seam_max_gap_fraction": 0.15,
    "seam_min_axis_overlap_fraction": 0.5,
    "trim_panel_whitespace": true,
    "trim_min_background_fraction": 0.985,
    "trim_max_margin_fraction": 0.04,
    "dedupe_duplicate_panels": true,
    "duplicate_iou_threshold": 0.6
  },
  "marker": {
    "host": "127.0.0.1",
    "port": 8765,
    "auto_open_browser": true,
    "magi_enabled": true,
    "magi_repo_id": "ragavsachdeva/magiv3",
    "magi_model_dir": "checkpoints/magiv3",
    "magi_panel_score_threshold": 0.5,
    "click_to_select": true,
    "shortcuts": {
      "save": [
        "mod+s"
      ],
      "mark_full_page": [
        "mod+f"
      ],
      "tool_draw": [
        "d"
      ],
      "tool_adjust": [
        "v"
      ],
      "prev_page": [
        "arrowleft"
      ],
      "next_page": [
        "arrowright"
      ],
      "delete_mark": [
        "delete",
        "backspace"
      ],
      "reset_view": [
        "0"
      ]
    }
  },
  "reviewer": {
    "host": "127.0.0.1",
    "port": 8766,
    "auto_open_browser": true
  },
  "tts": {
    "engine": "kokoro",
    "lang": "EN",
    "speed": 1.0,
    "synth_timeout_seconds": 180,
    "kokoro": {
      "hf_repo_id": "hexgrad/Kokoro-82M",
      "model_dir": "checkpoints/kokoro_82m",
      "voice": "af_heart",
      "volume_boost_db": 0.0,
      "sample_rate": 24000
    }
  },
  "ocr": {
    "hf_repo_id": "deepseek-ai/DeepSeek-OCR-2",
    "model_dir": "checkpoints/deepseek_ocr_2",
    "prompt": "<image>\nFree OCR.",
    "base_size": 1024,
    "image_size": 768,
    "crop_mode": true
  },
  "audio": {
    "sample_rate": 44100,
    "edge_fade_ms": 35,
    "pause_between_panels_ms": 350,
    "bgm_enabled": false,
    "bgm_path": "",
    "bgm_volume_db": -22.0,
    "enable_loudnorm": true,
    "duck_music_under_narration": false,
    "duck_depth_db": -9.0,
    "duck_fade_ms": 220,
    "duck_carve_db": -7.0,
    "voice_enhance": false,
    "voice_highpass_hz": 85,
    "voice_warmth_db": 2.5,
    "voice_presence_db": 3.0,
    "voice_compress": true,
    "voice_compress_threshold_db": -18.0,
    "voice_compress_ratio": 3.0
  },
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background_style": "blur",
    "blur_brightness": 0.42,
    "background_color": "#000000",
    "panel_padding_percent": 4,
    "auto_adaptive_padding": true,
    "panel_border_width": 2,
    "panel_border_color": "#222222"
  }
}
